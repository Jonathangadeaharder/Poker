{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"packageManager": "pnpm",
	"reporters": ["html", "clear-text", "progress"],
	"testRunner": "vitest",
	"vitest": {
		"configFile": "vitest.config.ts"
	},
	"coverageAnalysis": "perTest",
	"mutate": [
		"src/lib/core/adaptiveEngine.ts",
		"src/lib/core/gamification.ts",
		"src/lib/core/spacedRepetition.ts",
		"src/lib/core/soundManager.ts"
	],
	"thresholds": {
		"high": 80,
		"low": 60,
		"break": 60
	},
	"concurrency": 4,
	"timeoutMS": 30000,
	"timeoutFactor": 2
}

# Supabase — read by src/lib/supabase.ts via import.meta.env, so the VITE_PUBLIC_
# prefix is required (Vite only exposes VITE_-prefixed vars to the client). These
# are also passed as Docker build ARGs (see Dockerfile / docker-compose.yml).
VITE_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
VITE_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# PostHog Telemetry (Optional)
PUBLIC_POSTHOG_HOST=https://app.posthog.com
PUBLIC_POSTHOG_PROJECT_TOKEN=

